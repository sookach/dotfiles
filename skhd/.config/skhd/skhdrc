# ============================================================
# yabai + skhd
# ============================================================


# ============================================================
# FOCUS
# ============================================================

ctrl + cmd - h : yabai -m window --focus west
ctrl + cmd - j : yabai -m window --focus south
ctrl + cmd - k : yabai -m window --focus north
ctrl + cmd - l : yabai -m window --focus east


# ============================================================
# MOVE WINDOWS
# ============================================================

ctrl + cmd - u : yabai -m window --warp west
ctrl + cmd - i : yabai -m window --warp south
ctrl + cmd - o : yabai -m window --warp north
ctrl + cmd - p : yabai -m window --warp east


# ============================================================
# INSERTION POINT
# ============================================================

ctrl + cmd - m : yabai -m window --insert west
ctrl + cmd - 0x2B : yabai -m window --insert south
ctrl + cmd - 0x2F : yabai -m window --insert north
ctrl + cmd - 0x2C : yabai -m window --insert east


# ============================================================
# WINDOW / LAYOUT TOGGLES
# ============================================================

alt - 0x2F : yabai -m window --toggle float
alt - 0x2C : yabai -m window --toggle zoom-fullscreen


# ============================================================
# RESIZE
# ============================================================

ctrl + cmd - 0x1B : yabai -m window --resize left:-50:0
ctrl + cmd - 0x18 : yabai -m window --resize left:50:0


# ============================================================
# FULLSCREEN
# ============================================================

ctrl + cmd - f : yabai -m window --toggle zoom-fullscreen


# ============================================================
# SPACES
# ============================================================

alt - 1 : yabai -m space --focus 1
alt - 2 : yabai -m space --focus 2
alt - 3 : yabai -m space --focus 3
alt - 4 : yabai -m space --focus 4
alt - 5 : yabai -m space --focus 5
alt - 6 : yabai -m space --focus 6
alt - 7 : yabai -m space --focus 7
alt - 8 : yabai -m space --focus 8
alt - 9 : yabai -m space --focus 9

ctrl + cmd - 0x29 : yabai -m space --focus prev
ctrl + cmd - 0x27 : yabai -m space --focus next

alt - z : yabai -m space --focus prev
alt - x : yabai -m space --focus next


# ============================================================
# MOVE WINDOW TO SPACE
# ============================================================

alt + shift - 1 : yabai -m window --space 1
alt + shift - 2 : yabai -m window --space 2
alt + shift - 3 : yabai -m window --space 3
alt + shift - 4 : yabai -m window --space 4
alt + shift - 5 : yabai -m window --space 5
alt + shift - 6 : yabai -m window --space 6
alt + shift - 7 : yabai -m window --space 7
alt + shift - 8 : yabai -m window --space 8
alt + shift - 9 : yabai -m window --space 9

alt + shift - 0x29 : yabai -m window --space prev
alt + shift - 0x27 : yabai -m window --space next


# ============================================================
# APPLICATION LAUNCHERS
# ============================================================

alt - f : osascript -e 'tell application "Finder" to make new Finder window to (get home)'

alt - g : osascript -e 'tell application "Ghostty" to new window'

alt - s : osascript -e 'tell application "Safari" to make new document at end of documents'


# ============================================================
# CLOSE WINDOW
# ============================================================

ctrl + cmd - w : yabai -m window --close
