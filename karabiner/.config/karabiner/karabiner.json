      "complex_modifications": {
        "rules": [
          {
            "description": "Open a new Safari window with Option-Shift-S",
            "manipulators": [
              {
                "from": {
                  "key_code": "s",
                  "modifiers": {
                    "mandatory": [
                      "option"
                    ],
                    "optional": [
                      "any"
                    ]
                  }
                },
                "to": [
                  {
                    "shell_command": "osascript -e 'tell application \"Safari\"\n  make new document\n  activate\nend tell'"
                  }
                ],
                "type": "basic"
              }
            ]
          },
          {
            "description": "Open a new Finder window with Option-F",
            "manipulators": [
              {
                "from": {
                  "key_code": "f",
                  "modifiers": {
                    "mandatory": [
                      "option"
                    ],
                    "optional": []
                  }
                },
                "to": [
                  {
                    "shell_command": "osascript -e 'tell application \"Finder\"\n  make new Finder window to (get home)\n  activate\nend tell'"
                  }
                ],
                "type": "basic"
              }
            ]
          },
