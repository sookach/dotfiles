#!/usr/bin/env zsh

# ============================================================
# yabai configuration
# ============================================================

# ------------------------------------------------------------
# Layout
# ------------------------------------------------------------

# BSP tiling, like Hyprland's tile layout/dwindle algorithm
yabai -m config layout bsp

# New windows go to the right/bottom of the focused window
yabai -m config window_placement second_child

# Let yabai automatically choose horizontal/vertical splits
# based on the window geometry.
yabai -m config split_type auto

# Don't automatically rebalance the entire tree.
yabai -m config auto_balance off

# Default split ratio
yabai -m config split_ratio 0.50


# ------------------------------------------------------------
# Gaps
# ------------------------------------------------------------

yabai -m config window_gap 9

yabai -m config top_padding 4
yabai -m config bottom_padding 4
yabai -m config left_padding 4
yabai -m config right_padding 4


# ------------------------------------------------------------
# Window behavior
# ------------------------------------------------------------

# Don't move the mouse when focus changes.
yabai -m config mouse_follows_focus off

# Don't focus windows merely by moving the mouse.
yabai -m config focus_follows_mouse off

# No macOS animation when yabai changes window geometry.
yabai -m config window_animation_duration 0.0

# Keep normal macOS window shadows.
yabai -m config window_shadow on

# Don't use yabai opacity.
yabai -m config window_opacity off


# ------------------------------------------------------------
# Mouse
# ------------------------------------------------------------

# Hold Ctrl while dragging windows.
yabai -m config mouse_modifier ctrl

# Ctrl + left click = move
yabai -m config mouse_action1 move

# Ctrl + right click = resize
yabai -m config mouse_action2 resize

# Dropping a window onto another swaps them.
yabai -m config mouse_drop_action swap


# ------------------------------------------------------------
# Borders
# ------------------------------------------------------------

# yabai itself does not need to render the borders.
# JankyBorders handles this separately.


echo "yabai configuration loaded."
