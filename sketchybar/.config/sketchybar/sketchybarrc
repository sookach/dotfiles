CONFIG_DIR="$HOME/.config/sketchybar"
BINARY_DIR="$CONFIG_DIR/bin"
PLUGIN_DIR="$CONFIG_DIR/plugins"


default=(
  icon.font="NotoSansM Nerd Font Mono:Bold:18.0"
  label.font="NotoSansM Nerd Font Mono:Bold:12.0"
  background.drawing=on 
  background.color=0xff000000 
  background.corner_radius=15 
  background.height=24 
  background.border_color=0xffffffff
  background.border_width=1
)

sketchybar --default "${default[@]}"

sketchybar --add event space_change

sketchybar --bar \
  color=0x00000000 \
  height=30 \

sketchybar --add item apple left \
  --set apple \
    icon= \
    icon.y_offset=1 \
    icon.padding_left=12 \
    icon.padding_right=12 \
    label.drawing=off \
    click_script="$BINARY_DIR/apple-menu"

sketchybar --add itme empty left \
  --set empty \
    background.drawing=off \
    label.width=12

sketchybar --add item space left \
  --set space \
    script="$PLUGIN_DIR/current-space.sh" \
    icon.drawing=off \
    label.drawing=on \
    label.padding_left=12 \
    background.drawing=off
  --subscribe space space_change

sketchybar --add item front_app left \
  --set front_app \
    script="$PLUGIN_DIR/front-app-icon.sh" \
    icon.drawing=off \
    label.drawing=off \
    icon.background.image.padding_left=12 \
    icon.background.image.padding_right=12 \
    background.drawing=off \
  --subscribe front_app front_app_switched

sketchybar --add bracket left_bar space front_app \
  --set left_bar \
    background.drawing=on \
    background.color=0xff000000 \
    background.corner_radius=15 \
    background.height=24 \

sketchybar --add item clock right \
  --set clock \
    script="$PLUGIN_DIR/clock.sh" \
    update_freq=1 \
    icon.drawing=off \
    label.drawing=on \
    label.padding_left=12 \
    label.padding_right=12

sketchybar --add item battery right \
  --set battery \
    script="$PLUGIN_DIR/battery.sh" \
    update_freq=120 \
    icon.drawing=on \
    icon.font="NotoSansM Nerd Font Mono:Bold:20.0" \
    icon.padding_left=12 \
    icon.padding_right=12 \
    label.drawing=on \
    label.padding_right=12 \
    background.height=24 \
    background.padding_right=12
  --subscribe battery system_woke power_source_change

sketchybar --add item wifi right \
  --set wifi \
    script="$PLUGIN_DIR/wifi.sh" \
    update_freq=30 \
    icon.drawing=on \
    icon.font="NotoSansM Nerd Font Mono:Bold:25.0" \
    label.drawing=on \
    label.font="NotoSansM Nerd Font Mono:Bold:15.0" \
    icon.padding_left=12 \
    icon.padding_right=12 \
    label.padding_left=4 \
    label.padding_right=12 \
    background.padding_right=12 \
  --subscribe wifi system_woke

sketchybar --update
