[user]
	name = Andrew Sukach
  email = github@sukach.org
	signingkey = ~/.ssh/id_ed25519.pub
[core]
	editor = nvim
[gpg]
	format = ssh
[github]
	user = sookach
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[url "ssh://git@github.com/"]
  insteadOf = https://github.com/
  insteadOf = http://github.com/
  insteadOf = git://github.com/
